$begin 'Configs'
	$begin 'Configs'
		$begin 'DSOConfig'
			ConfigName='OrPen_Q3D_Local'
			DesignType='Q3D Extractor'
			$begin 'DSOMachineList'
				$begin 'DSOMachineInfo'
					MachineName='localhost'
					NumEngines=1
					NumCores=30
					IsEnabled=true
					RAMPercent=45
					NumJobCores=0
					NumGPUs=0
				$end 'DSOMachineInfo'
			$end 'DSOMachineList'
			UseAutoSettings=false
			NumVariationsToDistribute=1
			$begin 'DSOJobDistributionInfo'
				AllowedDistributionTypes[3: 'Variations', 'Solver Types', 'Frequencies']
				Enable2LevelDistribution=false
				NumL1Engines=0
				UseDefaultsForDistributionTypes=false
				Context()
			$end 'DSOJobDistributionInfo'
			$begin 'DSOMachineOptionsInfo'
				MenuValues()
				IntValues()
				BoolValues()
				DoubleValues()
			$end 'DSOMachineOptionsInfo'
		$end 'DSOConfig'
	$end 'Configs'
$end 'Configs'
